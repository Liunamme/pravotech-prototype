# Что НЕ должно попасть в контекст сборки образа.
#
# Дело не только в скорости: всё, что сюда попадает, оседает в слоях образа
# и уезжает вместе с ним. `.env` и `.git` в опубликованном образе — это
# утечка, а не лишний вес.

node_modules
dist
.git
.github
.env
.env.*
*.log

# Выгрузка макета: эталон для вёрстки, сборке не нужна.
design

# Документация и служебное — в образе им делать нечего.
docs
*.md
.vscode
.idea
.DS_Store
