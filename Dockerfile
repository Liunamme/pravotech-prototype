# Контейнер со статической сборкой прототипа ПравоТех.
#
# Для GitHub Pages он НЕ нужен: Pages раздаёт готовые файлы из `dist/`, и
# `.github/workflows/deploy.yml` собирает их сам. Этот образ — на будущее:
# свой хостинг, свой домен, локальный показ заказчику одной командой.
#
#   docker build -t pravotech .
#   docker run --rm -p 8080:8080 pravotech      → http://localhost:8080
#
# Что здесь важно и почему:
#
# • Две стадии. Node нужен только чтобы собрать; в итоговый образ он не
#   попадает — там лежит nginx и полтора мегабайта статики. Меньше образ —
#   меньше поверхность атаки и нечего обновлять от чужих CVE.
# • Образ nginx — unprivileged: обычный `nginx:alpine` стартует от root и
#   слушает 80. Этот работает от пользователя 101 и слушает 8080, поэтому
#   контейнер не требует привилегий и его можно гонять в кластере с
#   запретом root.
# • Версии закреплены тегами. Перед выкладкой на настоящий хостинг закрепите
#   ещё и digest (`node:22.20-alpine@sha256:…`) — тег могут перевыпустить, и
#   образ незаметно изменится под вами.

# ─────────────────────────── сборка ───────────────────────────
FROM node:22.20-alpine AS build

WORKDIR /app

# Сначала манифесты, потом код: слой с `npm ci` переиспользуется, пока
# зависимости не менялись, и пересборка после правки компонента занимает
# секунды вместо минут.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# `npm run build` — это `tsc -b && vite build`: образ не соберётся на коде,
# который не проходит проверку типов.
RUN npm run build

# ──────────────────────────── раздача ────────────────────────────
FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime

# Заголовки безопасности, которые GitHub Pages выставить не даёт — ради них
# в том числе и нужен свой хостинг для чувствительного кабинета.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Совпадает с портом в nginx.conf; 8080, а не 80, потому что процесс не root.
EXPOSE 8080

# Проверка живости: оркестратор должен отличать «контейнер запущен» от
# «приложение отвечает».
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --spider http://127.0.0.1:8080/ || exit 1
